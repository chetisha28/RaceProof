# -------------------------------------------------------------
# Backend Environment Configuration (Render Web Service)
# -------------------------------------------------------------
PORT=5000
NODE_ENV=production

# Frontend URL (Your Vercel deployment URL)
# Example: https://raceproof.vercel.app or comma-separated if multiple
CLIENT_URL=https://<your-vercel-app>.vercel.app

# Database (Neon Serverless PostgreSQL)
# Get this from your Neon Console (Dashboard -> Connection Details)
# Neon connection strings must include ?sslmode=require
# Tip: Use the direct connection URL or pooled URL with &pgbouncer=true
DATABASE_URL="postgresql://<user>:<password>@<ep-pooler-or-direct>.neon.tech/neondb?sslmode=require"
TEST_DATABASE_URL="postgresql://<user>:<password>@<ep-pooler-or-direct>.neon.tech/raceproof_test?sslmode=require"

# Authentication Secrets
JWT_SECRET=replace-with-a-random-secure-string-min-32-chars
JWT_EXPIRES_IN=7d
COOKIE_SECRET=replace-with-another-secure-random-string

# Concurrency & Simulation Settings
INVITE_EXPIRY_HOURS=24
